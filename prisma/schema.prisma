generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(cuid())
  name              String
  username          String           @unique
  passwordHash      String
  role              String
  createdAt         DateTime         @default(now())
  signatures        FicheSignature[]
  assignedTemplates FicheTemplate[]  @relation("FicheTemplateToUser")

  @@map("users")
}

model FicheTemplate {
  id            String          @id @default(cuid())
  ref           String          @unique
  titre         String
  version       String
  equipement    String
  systeme       String
  intervention  String
  epi           String
  consignesA    String
  consignesNe   String
  actions       String
  ressources    String
  actif         Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  instances     FicheInstance[]
  assignedUsers User[]          @relation("FicheTemplateToUser")

  @@map("fiche_templates")
}

model FicheInstance {
  id                  String           @id @default(cuid())
  templateId          String
  numeroOT            String           @unique
  zone                String
  centreCharge        String
  superviseur         String
  superviseurUsername String?          // <-- nouvelle colonne
  datePrevue          DateTime
  dateFinPrevue       DateTime
  status              String           @default("BROUILLON")
  machinisteNom       String?
  dateEntretien       DateTime?
  actionsCochees      String?
  heureDebut          String?
  heureFin            String?
  observation         String?
  chefEquipeNom       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  template            FicheTemplate    @relation(fields: [templateId], references: [id])
  signatures          FicheSignature[]

  @@map("fiche_instances")
}
model FicheSignature {
  id            String        @id @default(cuid())
  ficheId       String
  userId        String
  role          String
  signatureData String?
  signedAt      DateTime      @default(now())
  fiche         FicheInstance @relation(fields: [ficheId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@unique([ficheId, role])
  @@map("fiche_signatures")
}
